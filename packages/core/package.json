{
  "name": "driverkit",
  "version": "0.0.0",
  "description": "Make a web app drivable by an agent. No pixels, no selectors, no model.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "keywords": [
    "agent",
    "mcp",
    "automation",
    "llm"
  ],
  "sideEffects": false
}

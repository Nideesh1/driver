{
  // The build config for this package. It emits `dist/`, and it is the only
  // config in the repository that emits anything.
  //
  // `composite` plus `references` is what makes a bare `driverkit` import
  // resolve to a sibling's BUILT `.d.ts` rather than to its source: `tsc -b`
  // builds the referenced projects first and typechecks this one against their
  // output, so the types this package compiles against are the exact types a
  // consumer of the published package gets. The root `tsconfig.build.json`
  // lists every package and derives the build order from these references.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // `tsconfig.base.json` sets `noEmit` for the two typecheck-only configs at
    // the root. This turns it back on for the one job that is emit.
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // The source text goes INTO the map. `files: ["dist"]` means `src/` is not
    // published, so a map that merely pointed at `../src/x.ts` would dangle in
    // every installed copy -- and a sourcemap that cannot find its source is
    // worse than no sourcemap, because the debugger shows an empty pane
    // instead of the emitted line it does have.
    "inlineSources": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"]
}

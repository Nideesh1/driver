{
  // `tsc -b tsconfig.build.json` builds the published package.
  //
  // It used to list six projects and derive a build order from their
  // references. There is one now, and the ordering problem went with the
  // split: the areas under `packages/driverkit/src` import each other by
  // relative path, so they are one program.
  //
  // Kept as a solution-style config rather than inlined, for two reasons: it
  // is the file every script, the README and the plugin already name, and it
  // is where a second publishable package would be added if there is ever a
  // reason for one. `packages/eval` is not that -- it is a development tool
  // nobody installs, it publishes no `dist`, and it is deliberately absent
  // here. The repo-wide `tsconfig.json` typechecks it with everything else.
  "files": [],
  "references": [
    { "path": "./packages/driverkit" }
  ]
}
